<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:macros="sap.fe.macros">
	<HBox alignItems="Start" wrap="Wrap">
	  <Avatar id="_IDGenAvatar"
       src="{ProductImage}"
       displaySize="XL"
       displayShape="Square"
       imageFitType="Contain"
       class="sapUiMediumMarginEnd"
       >
      <detailBox>
       <LightBox id="_IDGenLightBox">
        <LightBoxItem id="_IDGenLightBoxItem"
           imageSrc="{ProductImage}"
          alt=""
          title="{ProductDescription}"
          subtitle=""
          >
        </LightBoxItem>
       </LightBox>
      </detailBox>
     </Avatar>
	<!-- Column 1 -->
	<VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" width="180px">
		<VBox class="sapUiMediumMarginBottom">
			<Label text="PRODUCT DESCRIPTION" class="headerLabelStyle"/>
			<Text text="{ProductDescription}" class="headerValueStyle"/>
		</VBox>
		<VBox class="sapUiMediumMarginBottom">
			<Label text="PRODUCT GROUP" class="headerLabelStyle"/>
			<Text text="{ProductGroup}" class="headerValueStyle"/>
		</VBox>
	</VBox>
	
	<!-- Column 2 -->
	<VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" width="160px">
		<VBox class="sapUiMediumMarginBottom">
			<Label text="CREATED BY" class="headerLabelStyle"/>
			<Text text="{CreatedByUser}" class="headerValueStyle"/>
		</VBox>
		<VBox class="sapUiMediumMarginBottom">
			<Label text="LAST CHANGED BY" class="headerLabelStyle"/>
			<Text text="{LastChangedByUser}" class="headerValueStyle"/>
		</VBox>
	</VBox>

	<!-- Column 3 -->
	<VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" width="160px">
		<VBox class="sapUiMediumMarginBottom">
			<Label text="CREATION DATE" class="headerLabelStyle"/>
			<Text text="{CreationDate}" class="headerValueStyle"/>
		</VBox>
		<VBox class="sapUiMediumMarginBottom">
			<Label text="LAST CHANGE DATE" class="headerLabelStyle"/>
			<Text text="{LastChangeDate}" class="headerValueStyle"/>
		</VBox>
	</VBox>

	<!-- Column 4 -->
	<VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom" width="220px">
		<VBox class="sapUiMediumMarginBottom">
			<Label text="STATUS" class="headerLabelStyle"/>
			<!-- Use generic text to gracefully handle standard status if present, screenshot shows a chip but text is fine -->
			<Text text="{Status}" class="headerValueStyle"/>
		</VBox>
	</VBox>
	</HBox>
</core:FragmentDefinition>