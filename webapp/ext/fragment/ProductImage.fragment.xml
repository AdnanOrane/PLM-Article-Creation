<core:FragmentDefinition xmlns:core="sap.ui.core" xmlns="sap.m" xmlns:macros="sap.fe.macros">
	<HBox alignItems="Start" wrap="Wrap">
	  <Avatar id="_IDGenAvatar"
       src="{ProductImage}"
       displaySize="XL"
       displayShape="Square"
       imageFitType="Contain"
       class="sapUiMediumMarginEnd"
       >
      <detailBox>
       <LightBox id="_IDGenLightBox">
        <LightBoxItem id="_IDGenLightBoxItem"
           imageSrc="{ProductImage}"
          alt=""
          title="{ProductDescription}"
          subtitle=""
          >
        </LightBoxItem>
       </LightBox>
      </detailBox>
     </Avatar>
     <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Product Description:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{ProductDescription}" />
       </HBox>
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Product Group:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{ProductGroup}" />
       </HBox>
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Status:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{Status}" />
       </HBox>
      </VBox>
      <VBox class="sapUiLargeMarginEnd sapUiSmallMarginBottom">
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Created By:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{CreatedByUser}" />
       </HBox>
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Creation Date:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{CreationDate}" />
       </HBox>
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Last Changed By:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{LastChangedByUser}" />
       </HBox>
       <HBox class="sapUiTinyMarginBottom" alignItems="Baseline">
         <Label text="Last Change Date:" class="sapUiTinyMarginEnd" design="Bold"/>
         <Text text="{LastChangeDate}" />
       </HBox>
     </VBox>
	</HBox>
</core:FragmentDefinition>